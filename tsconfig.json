{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Node types are for build-time-only code (the OG image generator under
    // src/pages/og/, and filesystem-based test helpers): everything that
    // reaches the deployed Worker at runtime uses fetch/Request/Response, not
    // Node builtins, so @cloudflare/workers-types stays authoritative there.
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
