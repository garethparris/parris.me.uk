---
// src/components/BlogCard.astro
interface Props {
  slug: string;
  title: string;
  category: string;
  // Deliberately the small thumbnail, not the full-size heroImage: this
  // renders at 120px tall, so the multi-hundred-KB hero is pure waste here.
  thumbImage: string;
}
const { slug, title, category, thumbImage } = Astro.props;
---
<a href={`/blog/${slug}`} style="display: block; background: var(--color-bg-raised); border: 1px solid var(--color-border); border-radius: var(--radius); overflow: hidden; text-decoration: none; color: var(--color-text);">
  <img src={thumbImage} alt={title} loading="lazy" style="width: 100%; height: 120px; object-fit: cover; display: block;" />
  <div style="padding: var(--space-2);">
    <h2 style="margin: 0 0 4px; font-size: 0.95rem;">{title}</h2>
    <span class="tag">{category}</span>
  </div>
</a>
